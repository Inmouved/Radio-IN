<Window x:Class="RadioIN.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RadioIN;assembly=RadioIN" Title="Radio IN — Bêta 1.4" Width="440" SizeToContent="Height" ResizeMode="CanMinimize" WindowStyle="None" Background="#101927" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Border BorderBrush="#40515D71" BorderThickness="1">
 <Grid ClipToBounds="True" Background="#101927">
  <Border x:Name="BackdropLayer" Opacity="0.8" IsHitTestVisible="False"><Border.Background><ImageBrush x:Name="Backdrop" Stretch="UniformToFill"/></Border.Background><Border.Effect><BlurEffect Radius="22"/></Border.Effect></Border>
  <Border x:Name="PreviousBackdropLayer" Opacity="0" IsHitTestVisible="False"><Border.Background><ImageBrush x:Name="PreviousBackdrop" Stretch="UniformToFill"/></Border.Background><Border.Effect><BlurEffect Radius="22"/></Border.Effect></Border>
  <Border x:Name="TintLayer" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#AF101927" Offset="0"/><GradientStop Color="#EC101927" Offset="1"/></LinearGradientBrush></Border.Background></Border>
 <ScrollViewer x:Name="PlayerViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="18" TextElement.Foreground="#F5F7FA">
  <WrapPanel x:Name="DragArea" Background="Transparent" Margin="0,0,0,14"><TextBlock Text="RADIO IN" Foreground="#F5F7FA" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="OptionsButton" Content="⋯" ToolTip="Options, favoris, minuterie et raccourcis" Padding="7,4"/><Button x:Name="DesignButton" Content="Design ▾" Padding="7,4"/><Button x:Name="ModeButton" Content="Compact ▾" Padding="7,4"/><Button x:Name="MinimizeButton" Content="−" Width="26" Padding="0" ToolTip="Réduire près de l’horloge"/><Button x:Name="CloseWindowButton" Content="×" Width="26" Margin="0" Padding="0" ToolTip="Quitter Radio IN"/></WrapPanel>
  <local:MarqueeText x:Name="ReducedSong" Visibility="Collapsed" FontSize="15" FontWeight="SemiBold" Foreground="#F5F7FA"/>
  <Grid x:Name="CoverStage" Height="402" Visibility="Collapsed" ClipToBounds="True" Background="#101927">
   <TextBlock Text="IN" Foreground="#AFC5DF" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <Image x:Name="CoverArt" Stretch="UniformToFill"/><Image x:Name="PreviousCoverArt" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>
   <Border x:Name="CoverHud" Background="#E6111C2A" Padding="14" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"><StackPanel>
    <local:MarqueeText x:Name="CoverTitle" Text="Radio IN" FontSize="20" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="CoverArtist" Foreground="#CAD6E7" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
    <DockPanel Margin="0,12,0,0"><Button x:Name="CoverPlay" Content="▶ Écouter" Width="115"/><Button x:Name="CoverMute" Content="Son" ToolTip="Couper le son" Padding="7,6"/><Button x:Name="CoverFavorite" Content="♡" ToolTip="Ajouter le titre aux favoris" AutomationProperties.Name="Ajouter le titre aux favoris" Padding="9,6"/><Slider x:Name="CoverVolume" Minimum="0" Maximum="1" VerticalAlignment="Center" ToolTip="Volume"/></DockPanel>
   </StackPanel></Border>
  </Grid>
  <Grid x:Name="ArtRow"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Width="64" Height="64" Background="#DFE6EE" CornerRadius="6"><Grid><TextBlock Text="IN" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Art" Stretch="UniformToFill"/><Image x:Name="PreviousArt" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/></Grid></Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><DockPanel><TextBlock Text="● EN DIRECT" Foreground="#9FD9CC" FontSize="10" FontWeight="Bold"/><StackPanel x:Name="ListeningAnimation" Orientation="Horizontal" Margin="8,0,0,0" Height="11" HorizontalAlignment="Left" Opacity="0.35">
    <Border x:Name="PulseOne" Width="3" Height="10" Background="#9FD9CC" Margin="0,0,3,0" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.3"/></Border.RenderTransform></Border>
    <Border x:Name="PulseTwo" Width="3" Height="10" Background="#9FD9CC" Margin="0,0,3,0" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.3"/></Border.RenderTransform></Border>
    <Border x:Name="PulseThree" Width="3" Height="10" Background="#9FD9CC" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.3"/></Border.RenderTransform></Border>
   </StackPanel></DockPanel><local:MarqueeText x:Name="SongTitle" Text="Radio IN" Foreground="#F5F7FA" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,2"/><TextBlock x:Name="Artist" Text="Connexion à la radio…" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/></StackPanel>
  </Grid>
  <DockPanel x:Name="AudioControls" Margin="0,16,0,12"><Button x:Name="Play" Content="▶  Écouter" Click="TogglePlay" Width="115" Background="#2F4B6E" Foreground="White"/><Button x:Name="MuteButton" Content="Son" ToolTip="Couper le son" Padding="7,6"/><Button x:Name="FavoriteButton" Content="♡" ToolTip="Ajouter le titre aux favoris (Ctrl+F)" Padding="9,6"/><Slider x:Name="Volume" Minimum="0" Maximum="1" Value="0.75" VerticalAlignment="Center" ValueChanged="VolumeChanged" ToolTip="Volume"/></DockPanel>
  <WrapPanel x:Name="Navigation"><Button x:Name="HistoryButton" Content="Historique" Click="ShowHistory" Visibility="Collapsed"/><Button x:Name="RequestButton" Content="Demander un titre" Click="ShowRequests"/><Button x:Name="UpcomingButton" Content="À venir" Padding="8,7"/><CheckBox x:Name="Pin" Content="Épingler" Foreground="#CBD5E1" VerticalAlignment="Center" Checked="PinChanged" Unchecked="PinChanged"/></WrapPanel>
  <Button x:Name="LargeUpcomingButton" Content="À venir" HorizontalAlignment="Left" Visibility="Collapsed"/>
  <DockPanel Margin="0,8,0,0"><TextBlock x:Name="ConnectionBadge" DockPanel.Dock="Right" Foreground="#9FD9CC" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/><Button x:Name="RetryNow" Content="Réessayer maintenant" DockPanel.Dock="Right" Visibility="Collapsed" Padding="8,3"/><TextBlock x:Name="Status" Text="Prêt à écouter" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  <Grid x:Name="Panels"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel x:Name="HistoryPane" Visibility="Collapsed" Width="280" Margin="0,14,18,0"><TextBlock Text="Historique en direct" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><ListBox x:Name="LiveHistory" Height="345" Background="#90101A29" Foreground="#EDF3FC" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></StackPanel>
  <StackPanel x:Name="Drawer" Grid.Column="1" Visibility="Collapsed" Margin="0,14,0,0">
   <DockPanel><Button x:Name="ClosePanelButton" Content="Fermer" DockPanel.Dock="Right" Click="CloseDrawer"/><TextBlock x:Name="PanelTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <DockPanel x:Name="SearchPanel" Margin="0,10,0,8"><Button Content="Rechercher" DockPanel.Dock="Right" Click="SearchClick"/><TextBox x:Name="Search" Padding="6" KeyDown="SearchKey" ToolTip="Titre ou artiste"/></DockPanel>
   <ListBox x:Name="Items" Height="245" Margin="0,8,0,8" BorderThickness="0" Background="#90101A29" Foreground="#EDF3FC" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="5,6"><Button Content="♡" DockPanel.Dock="Right" Tag="{Binding}" ToolTip="Ajouter aux favoris" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Top"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="#ACB9CC" TextWrapping="Wrap"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <DockPanel x:Name="RequestActions"><Button x:Name="Send" Content="Demander la sélection" DockPanel.Dock="Right" Click="SendRequest"/><StackPanel Orientation="Horizontal"><Button x:Name="Previous" Content="‹" Click="PrevPage"/><TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="3,0,8,0"/><Button x:Name="Next" Content="›" Click="NextPage"/></StackPanel></DockPanel>
   <TextBlock x:Name="RequestFeedback" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#F5E1AA" Margin="0,8,0,0"/>
  </StackPanel>
  </Grid>
  <StackPanel x:Name="ExtraPanel" Visibility="Collapsed" Margin="0,14,0,0"><DockPanel><Button x:Name="CloseExtra" Content="Retour" DockPanel.Dock="Right"/><Button x:Name="RefreshQueue" Content="Actualiser" DockPanel.Dock="Right"/><TextBlock x:Name="ExtraTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="ExtraSearch" Visibility="Collapsed" Padding="6" Margin="0,8,0,0" ToolTip="Titre, artiste ou date (jj/mm/aaaa)" AutomationProperties.Name="Rechercher par titre, artiste ou date"/><ListBox x:Name="ExtraList" Height="285" Margin="0,10,0,8" BorderThickness="0" Background="#90101A29" Foreground="#EDF3FC" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><TextBlock x:Name="ExtraStatus" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap"/></StackPanel>
  <Border x:Name="InlineNotice" Visibility="Collapsed" CornerRadius="7" Padding="10" Margin="0,10,0,0" BorderThickness="1" BorderBrush="#8095AAC2"><DockPanel><Button x:Name="DismissNotice" Content="×" DockPanel.Dock="Right" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Fermer le message"/><ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="NoticeText" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/></ScrollViewer></DockPanel></Border>
  <TextBlock x:Name="VersionLabel" HorizontalAlignment="Right" Foreground="#B6C6D9" FontSize="10" Margin="0,6,0,0"/>
 </StackPanel></ScrollViewer>
 </Grid>
 </Border>
</Window>
